# Regional Discord channels (set at least one for live runs)
DISCORD_WEBHOOK_URL_IN=
DISCORD_WEBHOOK_URL_DE=
DISCORD_WEBHOOK_URL_OTHER=
DISCORD_WEBHOOK_URL_DEBUG=

# Adzuna per-country Discord webhooks (ISO 2-letter codes)
# IN and DE above also work for adzuna-in / adzuna-de boards.
DISCORD_WEBHOOK_URL_AU=
DISCORD_WEBHOOK_URL_AT=
DISCORD_WEBHOOK_URL_BE=
DISCORD_WEBHOOK_URL_BR=
DISCORD_WEBHOOK_URL_CA=
DISCORD_WEBHOOK_URL_CH=
DISCORD_WEBHOOK_URL_ES=
DISCORD_WEBHOOK_URL_FR=
DISCORD_WEBHOOK_URL_GB=
DISCORD_WEBHOOK_URL_IT=
DISCORD_WEBHOOK_URL_MX=
DISCORD_WEBHOOK_URL_NL=
DISCORD_WEBHOOK_URL_NZ=
DISCORD_WEBHOOK_URL_PL=
DISCORD_WEBHOOK_URL_SG=
DISCORD_WEBHOOK_URL_ZA=

# Adzuna API (https://developer.adzuna.com)
# One app id, up to 5 API keys (round-robin). Keys 2–5 use ADZUNA_APP_KEY_N suffix.
# Alternative bulk format: ADZUNA_CREDENTIALS=id1:key1,id2:key2
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_APP_KEY_2=
ADZUNA_APP_KEY_3=
ADZUNA_APP_KEY_4=
ADZUNA_APP_KEY_5=
ADZUNA_MAX_PAGES=5
ADZUNA_MAX_DAYS_OLD=21
ADZUNA_WHAT=software

# Freehire API (https://freehire.me/docs/api — no key required)
FREEHIRE_MAX_PAGES=5
FREEHIRE_OPEN_WITHIN_DAYS=30
FREEHIRE_PAGE_SIZE=100
# Comma-separated OR categories (default: software_engineering,backend,frontend,fullstack,architecture,solutions_engineering)
FREEHIRE_CATEGORIES=

# JobsBase API (https://jobsbase.io/api-docs — no key required)
JOBSBASE_MAX_PAGES=5
JOBSBASE_POSTED_WITHIN=30d
JOBSBASE_PAGE_SIZE=100

# Himalayas remote jobs API (https://himalayas.app/docs/remote-jobs-api — no key required)
HIMALAYAS_MAX_PAGES=5
# HIMALAYAS_Q=   # leave unset for max coverage; profile filters narrow downstream

# Remotive remote jobs API (https://remotive.com/api/remote-jobs — no key required)
REMOTIVE_LIMIT=100
# REMOTIVE_CATEGORY=   # leave unset to fetch all categories
# REMOTIVE_SEARCH=     # leave unset for max coverage

LLM_API_KEY=
DISCORD_ROLE_ID=
# LLM_PROVIDER: gemini (default) or claude
LLM_PROVIDER=gemini
# LLM_MODEL: leave blank for the provider default
#   gemini -> gemini-2.0-flash | claude -> claude-haiku-4-5
LLM_MODEL=
SEEN_PATH=.state/seen.json
# Scoring profiles (comma-separated). Default: config/profile.yaml + config/profile-raj.yaml
# PROFILE_PATHS=config/profile.yaml,config/profile-raj.yaml
DRY_RUN=
# Tracker Sheet (optional): set both to mirror matches into a Google Sheet and
# enable the daily reminder pass. In CI these come from secrets, not this file.
GOOGLE_SHEET_ID=
# Max survivors to LLM-score per run. 0 = unlimited (score all filter-passing jobs).
SCORE_CAP=0
